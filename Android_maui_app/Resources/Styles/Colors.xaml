<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Splash stays white. After splash, light/dark follow the OS (Kotlin MindSilenceApp). -->
    <Color x:Key="SplashBackground">#FFFFFF</Color>
    <Color x:Key="IcLauncherBackground">#FFFFFF</Color>
    <Color x:Key="CalmBlue">#4A6FA5</Color>
    <Color x:Key="CalmGreen">#5B8A72</Color>
    <Color x:Key="CalmBackgroundLight">#F2F5F8</Color>
    <Color x:Key="CalmBackgroundDark">#121820</Color>
    <Color x:Key="CalmSurfaceLight">#FFFFFF</Color>
    <Color x:Key="CalmSurfaceDark">#1A2330</Color>
    <!-- Material 3 default surfaceContainerHigh (Kotlin Card / AlertDialog). -->
    <Color x:Key="CalmSurfaceContainerHighLight">#ECE6F0</Color>
    <Color x:Key="CalmSurfaceContainerHigh">#2B2930</Color>
    <Color x:Key="OnBackgroundLight">#1A2330</Color>
    <Color x:Key="OnBackground">#E8EEF4</Color>
    <!-- Material 3 AlertDialog scrim: black @ 32%. -->
    <Color x:Key="DialogScrim">#52000000</Color>
    <Color x:Key="SplashTitleGradientStart">#1FC0E0</Color>
    <Color x:Key="SplashTitleGradientMid">#1A9AD4</Color>
    <Color x:Key="SplashTitleGradientEnd">#0E72B8</Color>
    <Color x:Key="SplashTitleShadow">#1A9AD4</Color>

    <Color x:Key="Primary">#4A6FA5</Color>
    <Color x:Key="PrimaryDark">#4A6FA5</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#5B8A72</Color>
    <Color x:Key="SecondaryDarkText">#E8EEF4</Color>
    <Color x:Key="Tertiary">#4A6FA5</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#121820</Color>
    <Color x:Key="Magenta">#4A6FA5</Color>
    <Color x:Key="MidnightBlue">#1A2330</Color>
    <Color x:Key="OffBlack">#121820</Color>

    <Color x:Key="Gray100">#E8EEF4</Color>
    <Color x:Key="Gray200">#C8D0D8</Color>
    <Color x:Key="Gray300">#ACB4BC</Color>
    <Color x:Key="Gray400">#9199A1</Color>
    <Color x:Key="Gray500">#6E767E</Color>
    <Color x:Key="Gray600">#404850</Color>
    <Color x:Key="Gray900">#1A2330</Color>
    <Color x:Key="Gray950">#121820</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
