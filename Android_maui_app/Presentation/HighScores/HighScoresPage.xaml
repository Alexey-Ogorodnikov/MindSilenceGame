<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:res="clr-namespace:MindSilence.Resources"
             xmlns:hs="clr-namespace:MindSilence.Presentation.HighScores"
             x:Class="MindSilence.Presentation.HighScores.HighScoresPage"
             x:DataType="hs:HighScoresViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource CalmBackgroundLight}, Dark={StaticResource CalmBackgroundDark}}">
    <Grid RowDefinitions="Auto,*">
        <Grid BackgroundColor="{AppThemeBinding Light={StaticResource CalmSurfaceLight}, Dark={StaticResource CalmSurfaceDark}}"
              SafeAreaEdges="Container">
            <Grid ColumnDefinitions="Auto,*"
                  HeightRequest="64"
                  Padding="4,0">
                <Button Text="{x:Static res:AppResources.back}"
                        Style="{StaticResource TextButton}"
                        Command="{Binding BackCommand}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{x:Static res:AppResources.high_scores_title}"
                       FontSize="22"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"
                       Margin="8,0,0,0" />
            </Grid>
        </Grid>

        <Label Grid.Row="1"
               Text="{x:Static res:AppResources.high_scores_empty}"
               IsVisible="{Binding IsEmpty}"
               FontSize="16"
               Opacity="0.7"
               Margin="24"
               HorizontalOptions="Fill"
               VerticalOptions="Start"
               HorizontalTextAlignment="Start" />

        <ScrollView Grid.Row="1"
                    IsVisible="{Binding HasRecords}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}"
                                 Padding="24,16"
                                 Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="hs:HighScoreDayItem">
                        <Border Padding="16"
                                StrokeThickness="0"
                                Stroke="Transparent"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CalmSurfaceContainerHighLight}, Dark={StaticResource CalmSurfaceContainerHigh}}"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding DateText}"
                                       FontSize="16"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{DynamicResource CalmBlue}" />
                                <Label Text="{Binding AttemptsText}"
                                       FontSize="16" />
                                <Label Text="{Binding TotalTimeText}"
                                       FontSize="16" />
                                <Label Text="{Binding BestLevelText}"
                                       FontSize="16" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
