<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<OutputType Condition="'$(TargetFramework)' == 'net10.0'">Library</OutputType>
		<RootNamespace>MindSilence</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Mind Silence (MAUI)</ApplicationTitle>
		<ApplicationId>com.mindsilence.game.maui</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26</SupportedOSPlatformVersion>
		<NeutralLanguage>en</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MindSilence.Tests" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="MindSilence.Tests\**" />
		<EmbeddedResource Remove="MindSilence.Tests\**" />
		<MauiXaml Remove="MindSilence.Tests\**" />
		<None Remove="MindSilence.Tests\**" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<Compile Remove="Platforms\**\*.cs" />
		<None Include="Platforms\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#FFFFFF" ForegroundScale="1" />
		<MauiSplashScreen Include="Resources\Splash\splash_icon.png" Color="#FFFFFF" Resize="false" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\splash_icon.png" Resize="false" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Resources\AppResources.resx">
			<LogicalName>MindSilence.Resources.AppResources.resources</LogicalName>
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<Compile Update="Resources\AppResources.Designer.cs">
			<DependentUpon>AppResources.resx</DependentUpon>
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
	</ItemGroup>

</Project>
